# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets ──────────────────────────────────────────────────────────────
# .env.example IS committed; real .env files never are.
.env
.env.local
.env.*.local
!.env.example

# ── Backend data (regenerable — never committed) ──────────────────────────
backend/data/raw/
backend/data/processed/
backend/data/cache/
backend/data/*.db
backend/data/*.db-journal
*.parquet
*.feather

# NOTE: backend/models/ IS committed on purpose — Render boots by loading
# the .joblib files from disk, so they must be in the repo.
# Do not add backend/models/ to this file.

# ── Node / Next.js ───────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editors & OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ── Local tooling ────────────────────────────────────────────────────────
.claude/settings.local.json
