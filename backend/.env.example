# RenewCast backend configuration.
# Copy to .env and fill in. Blank values fall back to the defaults below.

# ── AI Copilot (optional) ────────────────────────────────────────────────
# Leave GEMINI_API_KEY blank and the deterministic explainer is used instead.
# The app is fully functional without a key — narration quality is the only
# thing that changes. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://renewcast.vercel.app

# ── Forecasting ──────────────────────────────────────────────────────────
WEATHER_CACHE_TTL_MIN=30
DEFAULT_HORIZON_HOURS=72
MAX_HORIZON_HOURS=72

# ── Paths (relative to the backend/ directory) ───────────────────────────
MODEL_DIR=models
DB_PATH=data/renewcast.db
CACHE_DIR=data/cache
