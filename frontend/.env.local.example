# Where the FastAPI backend is listening.
# Copy to .env.local. NEXT_PUBLIC_ is required — this is read in the browser.
#
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# On Vercel, set this in Project Settings → Environment Variables to the Render
# URL instead, e.g. https://renewcast-api.onrender.com — with no trailing slash.
# It is baked in at build time, so changing it needs a redeploy, not a restart.
